{
  "name": "@feedbakery/react",
  "version": "0.1.0",
  "description": "React wrapper for the Feedbakery feedback board widget",
  "license": "MIT",
  "homepage": "https://feedbakery.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedbakery/sdk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/feedbakery/sdk/issues"
  },
  "keywords": [
    "feedbakery",
    "feedback",
    "react",
    "embed",
    "widget"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build --mode esm && vite build --mode cjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && node ../../scripts/check-sdk-publish.mjs react"
  },
  "dependencies": {
    "@feedbakery/sdk": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^2.1.0"
  }
}
